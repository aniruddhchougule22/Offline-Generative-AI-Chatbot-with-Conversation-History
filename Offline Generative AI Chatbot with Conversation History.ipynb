
from pathlib import Path

import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

MODEL_ID = "HuggingFaceTB/SmolLM2-360M-Instruct"
MODEL_DIR = Path("smollm2_model")

SYSTEM_PROMPT = (
    "You are a helpful AI assistant. "
    "Explain concepts in simple English and use examples when helpful."
)

MAX_NEW_TOKENS = 150
MAX_HISTORY_MESSAGES = 6


def load_model():
    """Download the model if needed, then load it locally."""

    print("Loading AI model...")

    tokenizer = AutoTokenizer.from_pretrained(
        MODEL_DIR if MODEL_DIR.exists() else MODEL_ID,
        local_files_only=MODEL_DIR.exists()
    )

    model = AutoModelForCausalLM.from_pretrained(
        MODEL_DIR if MODEL_DIR.exists() else MODEL_ID,
        local_files_only=MODEL_DIR.exists()
    )

    model.to("cpu")
    model.eval()

    # Save model locally for future offline use
    MODEL_DIR.mkdir(parents=True, exist_ok=True)
    tokenizer.save_pretrained(MODEL_DIR)
    model.save_pretrained(MODEL_DIR)

    print("Model loaded successfully!")
    return tokenizer, model


tokenizer, model = load_model()


def generate_response(question, history):
    """Generate an answer using recent conversation history."""

    messages = [
        {"role": "system", "content": SYSTEM_PROMPT}
    ]

    messages.extend(history[-MAX_HISTORY_MESSAGES:])
    messages.append({"role": "user", "content": question})

    inputs = tokenizer.apply_chat_template(
        messages,
        add_generation_prompt=True,
        tokenize=True,
        return_dict=True,
        return_tensors="pt"
    )

    with torch.inference_mode():
        output = model.generate(
            **inputs,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=True,
            temperature=0.7,
            top_p=0.9,
            repetition_penalty=1.1,
            pad_token_id=tokenizer.eos_token_id
        )

    new_tokens = output[0][inputs["input_ids"].shape[1]:]

    answer = tokenizer.decode(
        new_tokens,
        skip_special_tokens=True
    ).strip()

    return answer or "Sorry, I could not generate an answer."


def start_chat():
    history = []

    print("\n" + "=" * 45)
    print("       OFFLINE GENAI CHATBOT")
    print("=" * 45)
    print("Type /reset to clear history.")
    print("Type /exit to stop.")

    while True:
        question = input("\nYou: ").strip()

        if not question:
            continue

        if question.lower() == "/exit":
            print("Bot: Goodbye!")
            break

        if question.lower() == "/reset":
            history.clear()
            print("Bot: Conversation history cleared.")
            continue

        try:
            answer = generate_response(question, history)
            print("\nBot:", answer)

            history.extend([
                {"role": "user", "content": question},
                {"role": "assistant", "content": answer}
            ])

            history = history[-12:]

        except Exception as error:
            print("Error generating response:", error)


if __name__ == "__main__":
    start_chat()
